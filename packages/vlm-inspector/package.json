{
  "name": "@chronoviet/vlm-inspector",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p eval/tsconfig.json",
    "lint": "tsc --noEmit",
    "test": "vitest run --dir src/ --passWithNoTests",
    "test:eval": "vitest run --dir eval/ --passWithNoTests",
    "eval": "tsx eval/runner.ts"
  },
  "dependencies": {
    "@chronoviet/shared-spec": "workspace:*",
    "@chronoviet/infra": "workspace:*",
    "ioredis": "^5.3.2",
    "sharp": "^0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/sharp": "^0.32.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
