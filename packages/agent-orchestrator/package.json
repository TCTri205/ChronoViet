{
  "name": "@chronoviet/agent-orchestrator",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p eval/tsconfig.json",
    "lint": "tsc --noEmit",
    "test": "vitest run --dir src/ --passWithNoTests",
    "test:eval": "vitest run --dir eval/ --passWithNoTests",
    "eval": "tsx eval/benchmarks/index.ts",
    "eval:all": "tsx eval/benchmarks/index.ts --all",
    "eval:quick": "tsx eval/benchmarks/index.ts --quick",
    "eval:a0": "tsx eval/benchmarks/index.ts --a0",
    "eval:a1": "tsx eval/benchmarks/index.ts --a1",
    "eval:a2": "tsx eval/benchmarks/index.ts --a2",
    "eval:a3": "tsx eval/benchmarks/index.ts --a3",
    "eval:a4": "tsx eval/benchmarks/index.ts --a4",
    "eval:a5": "tsx eval/benchmarks/index.ts --a5",
    "eval:sys": "tsx eval/benchmarks/index.ts --sys"
  },
  "dependencies": {
    "@chronoviet/infra": "workspace:*",
    "@chronoviet/rag-engine": "workspace:*",
    "@chronoviet/shared-spec": "workspace:*",
    "@chronoviet/vlm-inspector": "workspace:*",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^0.2.74"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
