{
  "name": "@chronoviet/rag-engine",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "pnpm clean",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p eval/tsconfig.json",
    "lint": "tsc --noEmit",
    "eval": "tsx eval/benchmarks/index.ts",
    "eval:all": "tsx eval/benchmarks/index.ts --all",
    "eval:sys": "tsx eval/benchmarks/index.ts --sys",
    "eval:c0": "tsx eval/benchmarks/index.ts --c0",
    "eval:c1": "tsx eval/benchmarks/index.ts --c1",
    "eval:c2": "tsx eval/benchmarks/index.ts --c2",
    "eval:c3": "tsx eval/benchmarks/index.ts --c3",
    "eval:c4": "tsx eval/benchmarks/index.ts --c4",
    "eval:c5": "tsx eval/benchmarks/index.ts --c5",
    "eval:c6": "tsx eval/benchmarks/index.ts --c6",
    "eval:c7": "tsx eval/benchmarks/index.ts --c7",
    "eval:c8": "tsx eval/benchmarks/index.ts --c8",
    "eval:c9": "tsx eval/benchmarks/index.ts --c9",
    "eval:c10": "tsx eval/benchmarks/index.ts --c10",
    "test": "vitest run --dir src/ --passWithNoTests",
    "test:eval": "vitest run --dir eval/ --passWithNoTests",
    "chat": "tsx src/cli/chat-cli.ts"
  },
  "dependencies": {
    "@chronoviet/shared-spec": "workspace:*",
    "@chronoviet/infra": "workspace:*",
    "@chronoviet/data-ingestion": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
