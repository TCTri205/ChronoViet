{
  "name": "@chronoviet/shared-spec",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces.d.ts",
      "default": "./dist/interfaces.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run --dir src/ --passWithNoTests",
    "test:eval": "vitest run --dir eval/ --passWithNoTests",
    "eval": "echo [shared-spec] No evaluation suite needed"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "pg": "^8.11.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
