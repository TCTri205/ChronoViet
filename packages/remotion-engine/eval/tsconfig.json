{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noImplicitAny": false
