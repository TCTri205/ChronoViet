{
  "name": "@chronoviet/remotion-engine",
  "version": "1.0.0",
  "main": "src/index.ts",
  "bin": {
    "remotion-engine": "src/cli.ts"
  },
  "scripts": {
    "start": "remotion preview src/index.ts --port=9876",
    "preview": "remotion preview src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit && tsc --noEmit -p eval/tsconfig.json",
    "lint": "tsc --noEmit",
    "test": "vitest run --dir src/ --passWithNoTests",
    "test:eval": "vitest run --dir eval/ --passWithNoTests",
    "cli": "tsx src/cli.ts",
    "render": "tsx src/cli.ts render",
    "render:quangtrung": "tsx src/cli.ts render QuangTrungVideo src/data/quang-trung/quangTrungTimeline.json out/quang_trung.mp4",
    "render:haibatrung": "tsx src/cli.ts render HaiBaTrungVideo src/data/hai-ba-trung/haiBaTrungTimeline.json out/hai_ba_trung.mp4",
    "render:mongolviet2": "tsx src/cli.ts render MongolViet2Video src/data/mongol-viet-2/mongolViet2Timeline.json out/mongol_viet_2.mp4",
    "still": "tsx src/cli.ts still",
    "eval": "tsx eval/runner.ts --ci",
    "setup-assets": "node eval/scripts/setup_assets.js"
  },
  "dependencies": {
    "@chronoviet/shared-spec": "workspace:*",
    "@remotion/cli": "4.0.507",
    "@remotion/google-fonts": "4.0.507",
    "@remotion/media-utils": "4.0.507",
    "@remotion/transitions": "4.0.507",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.507",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.18",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^1.2.0"
  }
}
