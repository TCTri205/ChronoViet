{
  "name": "@chronoviet/remotion-engine",
  "version": "1.0.0",
  "main": "src/index.ts",
  "bin": {
    "remotion-engine": "src/cli.ts"
  },
  "scripts": {
    "start": "remotion preview src/index.ts --port=9876",
    "preview": "remotion preview src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli.ts",
    "render": "tsx src/cli.ts render",
    "still": "tsx src/cli.ts still",
    "eval": "tsx eval/runner.ts --ci",
    "setup-assets": "node eval/scripts/setup_assets.js"
  },
  "dependencies": {
    "@chronoviet/shared-spec": "workspace:*",
    "@remotion/cli": "4.0.507",
    "@remotion/google-fonts": "4.0.507",
    "@remotion/media-utils": "4.0.507",
    "@remotion/transitions": "4.0.507",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.507",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
