{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@chronoviet/shared-spec/schema": ["../shared-spec/src/schema.ts"],
      "@chronoviet/shared-spec/interfaces": ["../shared-spec/src/interfaces.ts"],
      "@chronoviet/shared-spec": ["../shared-spec/src/index.ts"]
    },
    "outDir": "dist",
    "declaration": true
  },
  "include": ["src/**/*"]
}
