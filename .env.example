# ==============================================================================
# ChronoViet Monorepo — Master Environment Configuration Template
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# ==============================================================================
# [1] CORE INFRASTRUCTURE & DEPLOYMENT
# ==============================================================================
# Environment mode: development | production | test
NODE_ENV=development

# Web Application HTTP Port (Default: 3000)
PORT=3000

# Render Worker Health & Metrics Probe Port (Default: 3001)
WORKER_PROBE_PORT=3001

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# Logging format: pretty (human-readable colors) | json (structured for log aggregators)
LOG_FORMAT=pretty

# PostgreSQL + pgvector Connection URL (SSOT Priority #1)
DATABASE_URL=postgres://chronoviet:chronoviet_secret@localhost:5432/chronoviet_db

# Alternative individual Postgres parameters (used if DATABASE_URL is unset)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=chronoviet_db
# POSTGRES_USER=chronoviet
# POSTGRES_PASSWORD=chronoviet_secret
# DB_PASSWORD=chronoviet_secret
# PG_CONNECTION_TIMEOUT_MS=1000
# PG_IDLE_TIMEOUT_MS=10000

# Redis Cache & BullMQ Message Broker (Realtime Pub/Sub & Queue State)
REDIS_URL=redis://localhost:6379

# ==============================================================================
# [2] LOCAL AI ENGINE STACK (Offline Inference on Apple Silicon / GPU / ONNX)
# ==============================================================================
# Master switch for local LLM inference via llama-server (Qwen3.8)
USE_LOCAL_LLM=true
LOCAL_LLM_BACKEND=llama_cpp
LOCAL_LLM_MAX_CONCURRENCY=1
LOCAL_LLM_TIMEOUT_MS=120000
LLM_BASE_URL=http://localhost:8092
LLM_PORT=8092
MODEL_DIR=./models

# Primary local model for text generation & historical reasoning
LOCAL_LLM_PRIMARY_MODEL=qwen3.8-27b-instruct-q4_k_m

# High-precision model used for local ablation & benchmark evaluations
LOCAL_LLM_BENCHMARK_MODEL=qwen3.6-27b-instruct-q4_k_m

# Local Embeddings, Reranker & Vision Stack (SSOT 1024-dim Vector Space)
LOCAL_EMBEDDING_MODEL=bge-m3
EMBEDDING_API_URL=http://localhost:8090/v1/embeddings
EMBEDDING_PORT=8090
EMBEDDING_DIMENSION=1024
LOCAL_RERANK_MODEL=qwen3-reranker-0.6b
LOCAL_VISION_FILTER=siglip-2-multilingual-onnx
LOCAL_VLM_INSPECTOR=qwen3.8-27b-instruct-q4_k_m
HISTORICAL_OCR_ENGINE=paddleocr_v5_hannom

# ==============================================================================
# [3] CLOUD LLM GATEWAY & FALLBACK (Zero-Downtime Multi-Provider with Round-Robin)
# ==============================================================================
# Enable fallback to cloud when local LLM is unreachable or out of memory
ENABLE_CLOUD_FALLBACK=true

# Routing strategy: hybrid_round_robin (rotates evenly across Local & Cloud) | priority_fallback (Local first) | local_only
INFERENCE_ROUTING_MODE=hybrid_round_robin

# 24h Quota Cooldown for exhausted Cloud API Keys (86,400,000 ms)
DAILY_KEY_QUARANTINE_MS=86400000

REMOTE_FALLBACK_MODEL=agnes-2.5-flash
REMOTE_FALLBACK_TIMEOUT_MS=35000

# Agnes Cloud Fallback Provider (Official Endpoint: https://apihub.agnes-ai.com/v1)
# Supports comma-separated keys with exact Round-Robin rotation and auto-retry on HTTP 429
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_API_KEYS=sk-...,sk-...,sk-...
# AGNES_API_KEY=sk-...
# REMOTE_LLM_BASE_URL=https://apihub.agnes-ai.com/v1 # (Generic alias)

# Alternative Cloud Provider Keys (Exact Round-Robin & 429 Rate-Limit Quarantine Supported)
GEMINI_MODEL=gemini-3.6-flash
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_API_KEYS=AQ...,AQ...,AQ...
# GEMINI_API_KEY=AQ...

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_API_KEYS=sk-or-...,sk-or-...
# OPENROUTER_API_KEY=

# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEYS=sk-...,sk-...
# OPENAI_API_KEY=

# Hybrid Dev Mode (Skip local llama-server requirement in dev scripts, use Agnes cloud)
HYBRID_DEV=false

# ==============================================================================
# [4] MULTI-MODAL, TTS & ONLINE RESEARCH AGENT
# ==============================================================================
# VieNeu TTS ONNX Engine (Default port 8080)
VIENEU_PYTHON_URL=http://localhost:8080
TTS_SERVICE_PORT=8080
TTS_HTTP_TIMEOUT_MS=60000

# Vision Language Model (VLM) Inspector Provider Routing:
# Supported: auto | local | openai | gemini | clip
VLM_PROVIDER=auto
# VLM_BASE_URL=http://localhost:8091
# VLM_MODEL=qwen3.8-27b-instruct-q4_k_m
# VLM_API_KEY=
# IMAGE_DOWNLOAD_TIMEOUT_MS=10000
# IMAGE_DOWNLOAD_USER_AGENT=ChronoViet-VLM-Downloader/1.0 (https://chronoviet.vn; contact@chronoviet.vn)

# Image Research Agent (Online Search Providers with Round-Robin Rotation)
# Provider chain priority: serpapi -> tavily -> brave -> wikimedia -> catalog
# Multi-key supported: comma-separated list rotates across search queries and retries on 429
SERPAPI_API_KEYS=
# SERPAPI_API_KEY=
TAVILY_API_KEYS=tvly...,tvly...,tvly...
# TAVILY_API_KEY=
BRAVE_API_KEYS=
# BRAVE_API_KEY=
IMAGE_SEARCH_PROVIDER_CHAIN=serpapi,tavily,brave,wikimedia,catalog
IMAGE_DOMAIN_WHITELIST=upload.wikimedia.org,commons.wikimedia.org,live.staticflickr.com,flickr.com

# ==============================================================================
# [5] RENDERING PIPELINE & STORAGE
# ==============================================================================
REMOTION_PORT=9876
REMOTION_NODE_OPTIONS=--max-old-space-size=4096
RENDER_CONCURRENCY=1

MEDIA_DIR=./media
AUDIO_CACHE_DIR=./media/audio-cache
PROJECTS_MEDIA_ROOT=./media/projects

# ==============================================================================
# [6] OBSERVABILITY & EVALUATION GATES
# ==============================================================================
EVAL_MAX_RTF=0.3
EVAL_STRICT=false
EVAL_ALLOW_CLOUD_FALLBACK=false
# EVAL_VLM_MODEL=qwen3.8-27b-instruct-q4_k_m
