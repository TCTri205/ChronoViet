# ===========================================
# ChronoViet Environment Configuration
# Copy: cp .env.example .env
# ===========================================

# ==========================================
# Deployment
# ==========================================
NODE_ENV=development
PORT=3000

# ==========================================
# PostgreSQL Database
# Use DATABASE_URL (preferred) or individual POSTGRES_* fields.
# DATABASE_URL takes priority.
# ==========================================
DATABASE_URL=postgres://chronoviet:chronoviet_secret@localhost:5432/chronoviet_db
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=chronoviet
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# PG_CONNECTION_TIMEOUT_MS=1000
# PG_IDLE_TIMEOUT_MS=10000

# ==========================================
# Redis
# ==========================================
REDIS_URL=redis://localhost:6379

# ==========================================
# AI / External APIs & Local Model Gateway
# ==========================================
GEMINI_API_KEY=
# EMBEDDING_API_URL=http://localhost:8080/v1/embeddings

# Local AI Gateway & Endpoint Settings
USE_LOCAL_LLM=true
LOCAL_LLM_BACKEND=llama_cpp
LLM_BASE_URL=http://localhost:8080

# Supported Gateway Endpoints:
# - POST /v1/chat/completions (OpenAI Chat format)
# - POST /v1/responses        (OpenAI Responses API format)
# - POST /v1/messages         (Anthropic Messages API format)

# Primary Local Model (Qwen3.5-27B-Q4)
LOCAL_LLM_PRIMARY_MODEL=qwen3.5-27b-instruct-q4_k_m
LOCAL_LLM_BENCHMARK_MODEL=qwen3.6-27b-instruct-q4_k_m

# Zero-Downtime Remote API Fallback (Agnes 2.0 Flash)
ENABLE_CLOUD_FALLBACK=true
REMOTE_FALLBACK_MODEL=agnes-2.0-flash
AGNES_API_KEY=your_agnes_api_key_here
REMOTE_FALLBACK_TIMEOUT_MS=15000

# 2-Tier Embedding, Rerank & Vision Stack
LOCAL_EMBEDDING_DEFAULT=qwen3-embedding-0.6b
LOCAL_EMBEDDING_HIGH_QUALITY=qwen3-embedding-4b
LOCAL_RERANK_MODEL=qwen3-reranker-0.6b
LOCAL_VISION_FILTER=siglip-2-multilingual-onnx
LOCAL_VLM_INSPECTOR=qwen3-vl-8b
HISTORICAL_OCR_ENGINE=paddleocr_v5_hannom

# ==========================================
# TTS Service
# ==========================================
VIENEU_PYTHON_URL=http://localhost:8080
# TTS_SERVICE_PORT=8080
# TTS_HTTP_TIMEOUT_MS=60000

# ==========================================
# Remotion Engine
# ==========================================
# REMOTION_PORT=9876
# REMOTION_NODE_OPTIONS=--max-old-space-size=4096

# ==========================================
# Render Worker
# ==========================================
# RENDER_CONCURRENCY=1

# ==========================================
# Media Paths (relative to project root)
# ==========================================
# MEDIA_DIR=./media
# AUDIO_CACHE_DIR=./media/audio-cache

# ==========================================
# Evaluation
# ==========================================
# EVAL_MAX_RTF=0.3

# ==========================================
# Logging
# ==========================================
# LOG_LEVEL=info
