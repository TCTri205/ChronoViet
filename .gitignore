# Media Volume Storage (Keep directory structures via .gitkeep, ignore generated/raw media)
media/raw-assets/*
!media/raw-assets/.gitkeep
media/license-snapshots/*
!media/license-snapshots/.gitkeep
media/rendered-videos/*
!media/rendered-videos/.gitkeep
media/cache/*
!media/cache/.gitkeep
media/audio-cache/*
!media/audio-cache/.gitkeep
data/

# Database Backups
backups/*
!backups/.gitkeep

# TTS Service Media
services/vieneu-tts/media/audio-cache/*
!services/vieneu-tts/media/audio-cache/.gitkeep

# Evaluation Suite Artifacts (generated during test runs)
eval/reports/*.json
eval/reports/*.md
eval/out/*
!eval/out/.gitkeep

# Per-module eval artifacts (generated JSON/MD reports)
packages/*/eval/reports/*.json
packages/*/eval/reports/*.md
packages/*/eval/out/*
!packages/*/eval/out/.gitkeep
apps/*/eval/reports/*.json
apps/*/eval/reports/*.md
services/*/eval/reports/*.json
services/*/eval/reports/*.md

media/projects/*
!media/projects/.gitkeep
apps/*/media/
packages/*/media/

# Eval-generated audio caches
packages/remotion-engine/eval/public/audio/*
!packages/remotion-engine/eval/public/audio/.gitkeep
packages/remotion-engine/public/audio/*
!packages/remotion-engine/public/audio/.gitkeep