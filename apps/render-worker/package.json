{
  "name": "@chronoviet/render-worker",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p eval/tsconfig.json",
    "lint": "tsc --noEmit",
    "test": "vitest run --dir src/ --passWithNoTests",
    "test:eval": "vitest run --dir eval/ --passWithNoTests",
    "eval": "tsx eval/runner.ts"
  },
  "dependencies": {
    "@chronoviet/shared-spec": "workspace:*",
    "@chronoviet/infra": "workspace:*",
    "@chronoviet/vlm-inspector": "workspace:*",
    "@chronoviet/remotion-engine": "workspace:*",
    "bullmq": "^5.1.0",
    "ioredis": "^5.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^1.2.0"
  }
}
