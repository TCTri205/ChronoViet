{
  "name": "chronoviet-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ChronoViet - Automated Historical EdTech & Interactive GraphRAG Video Platform",
  "scripts": {
    "dev": "tsx scripts/dev-smart.ts",
    "dev:full": "tsx scripts/dev-orchestrator.ts",
    "dev:cloud": "tsx scripts/dev-hybrid.ts",
    "dev:hybrid": "tsx scripts/dev-hybrid.ts",
    "dev:data": "tsx scripts/dev-data.ts",
    "dev:web": "pnpm --filter @chronoviet/web dev",
    "dev:worker": "pnpm --filter @chronoviet/render-worker dev",
    "data:setup": "tsx scripts/setup-data.ts",
    "build": "pnpm --filter \"./packages/*\" run build && pnpm --filter @chronoviet/render-worker build && pnpm --filter @chronoviet/web build",
    "lint": "pnpm --recursive --workspace-concurrency=1 run lint",
    "test": "pnpm --recursive --workspace-concurrency=1 run test",
    "test:eval": "pnpm --recursive --workspace-concurrency=1 run test:eval",
    "typecheck": "pnpm --recursive --workspace-concurrency=1 run typecheck",
    "typecheck:extras": "tsc --noEmit -p tsconfig.extras.json",
    "check": "pnpm typecheck && pnpm typecheck:extras && pnpm lint && pnpm test && pnpm build",
    "check:all": "pnpm typecheck && pnpm typecheck:extras && pnpm lint && pnpm test && pnpm build",
    "stack:infra": "docker compose --profile infra up -d",
    "stack:prod": "docker compose --profile prod up -d",
    "stack:prod:all": "docker compose --profile prod --profile ai up -d",
    "stack:ai": "docker compose --profile ai up -d",
    "stack:tts": "docker compose --profile tts up -d",
    "stack:down": "docker compose down",
    "stack:ps": "docker compose ps",
    "stack:logs": "docker compose logs -f",
    "models:download": "bash scripts/download-models.sh",
    "models:download:lite": "bash scripts/download-models.sh lite",
    "models:download:emb": "bash scripts/download-models.sh emb",
    "models:download:extract": "bash scripts/download-models.sh extract",
    "models:download:llm": "bash scripts/download-models.sh llm",
    "models:download:rerank": "bash scripts/download-models.sh rerank",
    "models:download:all": "bash scripts/download-models.sh all",
    "ai": "tsx scripts/ai-cli.ts",
    "ai:start": "tsx scripts/ai-cli.ts start",
    "ai:all": "tsx scripts/ai-cli.ts all",
    "ai:supervisor": "tsx scripts/ai-supervisor.ts",
    "ai:local": "bash scripts/start-local-ai.sh",
    "ai:status": "tsx scripts/ai-cli.ts status",
    "ai:stop": "tsx scripts/ai-cli.ts stop",
    "ai:extract": "tsx scripts/ai-cli.ts extract",
    "ai:emb": "tsx scripts/ai-cli.ts emb",
    "ai:llm": "tsx scripts/ai-cli.ts llm",
    "ai:lite": "tsx scripts/ai-cli.ts lite",
    "ai:rerank": "tsx scripts/ai-cli.ts rerank",
    "ai:tts": "tsx scripts/ai-cli.ts tts",
    "tts:local": "bash scripts/start-tts-local.sh",
    "db:init": "pnpm --filter @chronoviet/data-ingestion db:init",
    "db:health": "tsx scripts/verify-db-health.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "db:clean": "tsx scripts/clean-db-duplicates.ts",
    "reset:data": "tsx scripts/reset-projects-data.ts",
    "db:audit-quarantine": "pnpm --filter @chronoviet/data-ingestion db:audit-quarantine",
    "crawl:corpus": "pnpm --filter @chronoviet/data-ingestion crawl:corpus",
    "crawl:all": "pnpm --filter @chronoviet/data-ingestion crawl:corpus --all",
    "crawl:pdf": "pnpm --filter @chronoviet/data-ingestion crawl:pdf-extracted",
    "extract:pdf": "pnpm --filter @chronoviet/data-ingestion extract:pdf",
    "ingest:vector": "pnpm --filter @chronoviet/data-ingestion ingest:vector",
    "ingest:graph": "pnpm --filter @chronoviet/data-ingestion ingest:graph",
    "ingest:stage1": "pnpm --filter @chronoviet/data-ingestion ingest:stage1",
    "ingest:stage2": "pnpm --filter @chronoviet/data-ingestion ingest:stage2",
    "ingest:knowledge": "pnpm --filter @chronoviet/data-ingestion ingest:knowledge",
    "rag:re-resolve": "pnpm --filter @chronoviet/data-ingestion rag:re-resolve",
    "rag:chat": "pnpm --filter @chronoviet/rag-engine chat",
    "setup-assets": "pnpm --filter @chronoviet/remotion-engine setup-assets",
    "remotion:studio": "pnpm --filter @chronoviet/remotion-engine start",
    "remotion:render": "pnpm --filter @chronoviet/remotion-engine build",
    "remotion:render:quangtrung": "pnpm --filter @chronoviet/remotion-engine render:quangtrung",
    "remotion:render:haibatrung": "pnpm --filter @chronoviet/remotion-engine render:haibatrung",
    "remotion:render:mongolviet2": "pnpm --filter @chronoviet/remotion-engine render:mongolviet2",
    "eval": "tsx eval/runner.ts",
    "eval:all": "tsx eval/runner.ts --all",
    "eval:chain": "tsx eval/runner.ts --chain vieneu-remotion",
    "eval:clean": "tsx eval/utils/cleaner.ts",
    "eval:ingest": "pnpm --filter @chronoviet/data-ingestion eval",
    "eval:ingest:vector": "pnpm --filter @chronoviet/data-ingestion eval:vector",
    "eval:ingest:graph": "pnpm --filter @chronoviet/data-ingestion eval:graph",
    "eval:ingest:triples": "pnpm --filter @chronoviet/data-ingestion eval:triples",
    "eval:ingest:ner": "pnpm --filter @chronoviet/data-ingestion eval:ner",
    "eval:ingest:diagnostic": "pnpm --filter @chronoviet/data-ingestion eval:diagnostic",
    "eval:orchestrator": "pnpm --filter @chronoviet/agent-orchestrator eval",
    "eval:research": "pnpm --filter @chronoviet/agent-orchestrator eval:research",
    "eval:rag": "pnpm --filter @chronoviet/rag-engine eval",
    "eval:vlm": "pnpm --filter @chronoviet/vlm-inspector eval",
    "eval:tts": "python3 services/vieneu-tts/eval/eval.py",
    "eval:remotion": "pnpm --filter @chronoviet/remotion-engine eval"
  },
  "devDependencies": {
    "@chronoviet/infra": "workspace:*",
    "@chronoviet/shared-spec": "workspace:*",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.6.2"
}
