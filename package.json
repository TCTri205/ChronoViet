{
  "name": "chronoviet-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ChronoViet - Automated Historical EdTech & Interactive GraphRAG Video Platform",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --recursive --workspace-concurrency=1 run build",
    "lint": "pnpm --recursive --workspace-concurrency=1 run lint",
    "test": "pnpm --recursive --workspace-concurrency=1 run test",
    "test:eval": "pnpm --recursive --workspace-concurrency=1 run test:eval",
    "typecheck": "pnpm --recursive --workspace-concurrency=1 run typecheck",
    "typecheck:extras": "tsc --noEmit -p tsconfig.extras.json",
    "eval": "tsx eval/runner.ts",
    "eval:all": "tsx eval/runner.ts --all",
    "eval:chain": "tsx eval/runner.ts --chain vieneu-remotion",
    "eval:clean": "tsx eval/utils/cleaner.ts",
    "stack:infra": "docker compose up -d postgres redis",
    "stack:down": "docker compose down",
    "db:init": "pnpm --filter @chronoviet/data-ingestion db:init",
    "ingest:knowledge": "pnpm --filter @chronoviet/data-ingestion ingest:knowledge",
    "rag:re-resolve": "pnpm --filter @chronoviet/data-ingestion rag:re-resolve",
    "rag:chat": "pnpm --filter @chronoviet/rag-engine chat",
    "eval:seed": "pnpm --filter @chronoviet/data-ingestion eval:seed",
    "eval:ingest": "pnpm --filter @chronoviet/data-ingestion eval",
    "eval:ingest:diagnostic": "pnpm --filter @chronoviet/data-ingestion eval:diagnostic",
    "crawl:corpus": "pnpm --filter @chronoviet/data-ingestion crawl:corpus",
    "crawl:all": "pnpm --filter @chronoviet/data-ingestion crawl:corpus --all",
    "setup-assets": "pnpm --filter @chronoviet/remotion-engine setup-assets",
    "remotion:studio": "pnpm --filter @chronoviet/remotion-engine start",
    "remotion:render": "pnpm --filter @chronoviet/remotion-engine build"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.6.2"
}
